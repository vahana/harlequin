/* VARIABLES */
$border-color-nofocus: $panel;
$border-title-color-nofocus: $panel;
$border-color-focus: $primary;
$border-title-color-focus: $primary;

#connections_hint {
    height: 1;
    padding: 0 1;
    color: $foreground-muted;
}

#connections {
    height: 1fr;
}

#connections_empty {
    height: auto;
    padding: 1 2;
    color: $foreground-muted;
}

ConnectionFormModal {
    align: center middle;
}

#connection_form {
    border: round $border-color-focus;
    background: $background;
    width: 90;
    max-width: 100%;
    height: 100%;
    max-height: 46;
    padding: 0 2;
}

#connection_form_title {
    text-style: bold;
    padding: 0 1;
}

#connection_fields {
    height: 1fr;
    min-height: 3;
}

#connection_options {
    height: auto;
}

ConnectionFormModal .option_row {
    height: 3;
    margin: 0 1 0 0;
}

ConnectionFormModal Horizontal Label {
    height: 1;
    text-align: right;
    width: 22;
}

ConnectionFormModal .select_label,
ConnectionFormModal .input_label,
ConnectionFormModal .switch_label {
    margin: 1 2 0 1;
}

ConnectionFormModal Horizontal.option_row > Label {
    margin-top: 1;
}

ConnectionFormModal Input,
ConnectionFormModal Select {
    width: 1fr;
}

#connection_error {
    color: $error;
    padding: 0 1;
    width: 100%;
    height: auto;
}

#connection_hint,
#connection_path {
    color: $foreground-muted;
    padding: 0 1;
    width: 100%;
    height: auto;
}

ConnectionFormModal #button_row {
    height: 3;
    margin-top: 0;
    align-horizontal: right;
}

ConnectionFormModal #button_row Button {
    margin-left: 2;
}
